{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["AGENTS.md"],
  "permission": {
    "skill": {
      "*": "allow",
      "test-*": "ask",
      "debug-*": "ask",
      "release-*": "ask",
      "deploy-*": "ask"
    }
  },
  "mcp": {
    "aa_workflow": {
      "type": "local",
      "command": [
        "bash",
        "-c",
        "cd ~/redhat-ai-workflow && source .venv/bin/activate && python3 -m server"
      ],
      "enabled": true,
      "timeout": 10000
    }
  }
}
